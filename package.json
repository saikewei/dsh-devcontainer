{
  "name": "dsh-devcontainer",
  "version": "0.1.0",
  "description": "Develop inside a Docker dev container on a remote machine over SSH, straight from DeepSeek Harness. Either as additive devc_* tools, or as routing providers that put the harness's ordinary bash/read/write/edit/glob/grep inside the container.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "devcontainer",
    "docker",
    "ssh",
    "remote",
    "container"
  ],
  "license": "MIT",
  "author": "saikewei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saikewei/dsh-devcontainer.git"
  },
  "homepage": "https://github.com/saikewei/dsh-devcontainer#readme",
  "bugs": {
    "url": "https://github.com/saikewei/dsh-devcontainer/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/boot.mjs && node test/routing.mjs && node test/registry.mjs && node test/smoke.mjs",
    "test:channel": "node tools/channel-probe.mjs",
    "test:skip": "echo \"npm test needs a live dev container — see README > Verification\""
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-bash-sandbox": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-fs-sandbox": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  }
}
